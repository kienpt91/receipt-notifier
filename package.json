{
  "name": "receipt-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts",
    "build:web": "esbuild src/web/form.ts --bundle --format=esm --outfile=public/form.js",
    "api": "npm run build:web && tsx src/api/server.ts",
    "relay": "tsx src/relay/relay.ts",
    "consumer": "tsx src/notification/consumer.ts",
    "worker": "tsx src/notification/worker.ts",
    "requeue": "tsx src/notification/requeue.ts",
    "purge": "tsx src/scripts/purge.ts",
    "reconciler": "tsx src/notification/reconciler.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@whop/sdk": "2.0.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "kafkajs": "2.2.4",
    "pg": "8.23.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "standardwebhooks": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
